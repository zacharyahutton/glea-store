# Copy to .env.local for local dev. Never commit real values.
# Shopify (public Storefront API token from the Headless channel). When empty, the site runs on the fixture.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=gjqatv-06.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-10

# Site URL used for canonical, sitemap and OG. Preview defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=
# Keep "false" until launch. "false" sends noindex on every page and disallows robots.
NEXT_PUBLIC_ALLOW_INDEX=false

# Analytics IDs (optional). Empty means the hook stays off.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Popup offer. Leave empty unless Zach confirms a real discount code exists.
NEXT_PUBLIC_POPUP_OFFER_CODE=
NEXT_PUBLIC_POPUP_OFFER_TEXT=
